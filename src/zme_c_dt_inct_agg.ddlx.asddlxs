// Metadata Extension para la entidad de consumo de incidentes (ZC_DT_INCT_AGG).
// Define cómo Fiori Elements presenta los datos: cabecera, ordenación, columnas,
// filtros de búsqueda, secciones del Object Page y el botón de acción.
@Metadata.layer: #CORE
@UI: {
  // Cabecera del List Report y del Object Page
  headerInfo: {
    typeName:       'Incident',
    typeNamePlural: 'Incidents',
    title: { type: #STANDARD, label: 'Incidents', value: 'IncidentID' }
  },
  // Ordenación por defecto: ascendente por IncidentID
  presentationVariant: [{
    sortOrder:      [{ by: 'IncidentID', direction: #ASC }],
    visualizations: [{ type: #AS_LINEITEM }]
  }]
}
annotate entity zc_dt_inct_agg with
{
  // Secciones (facets) del Object Page:
  // - 'Incident': formulario con los datos del incidente (#IDENTIFICATION_REFERENCE)
  // - 'History':  tabla con el historial de cambios de estado (#LINEITEM_REFERENCE)
  @UI.facet: [
    { id:            'Incident',
      purpose:       #STANDARD,
      type:          #IDENTIFICATION_REFERENCE,
      label:         'Incident',
      position:      10 },
    { id:            'History',
      purpose:       #STANDARD,
      type:          #LINEITEM_REFERENCE,
      label:         'History',
      position:      20,
      targetElement: '_History' }
  ]
  // IncUUID se oculta visualmente (@UI.hidden), pero su definición aquí
  // es necesaria para anclar el botón de acción 'changeStatus' en la barra de herramientas.
  // El botón aparece tanto en la lista como en el detalle del incidente.
  @UI.hidden: true
  @UI: {
    lineItem: [
      { position: 10, importance: #HIGH, label: 'IncUUID' },
      { type: #FOR_ACTION, dataAction: 'changeStatus', label: 'Change Status', position: 10 }
    ],
    identification: [
      { position: 10, label: 'IncUUID' },
      { type: #FOR_ACTION, dataAction: 'changeStatus', label: 'Change Status', position: 10 }
    ],
    selectionField: [{ position: 10 }]
  }
  IncUUID;

  // ID semántico del incidente — visible en lista y detalle, disponible como filtro
  @UI: {
    lineItem:       [{ position: 20, importance: #MEDIUM }],
    identification: [{ position: 20 }],
    selectionField: [{ position: 20 }]
  }
  IncidentID;

  // Título — visible en lista y detalle, pero NO como filtro de búsqueda (sin selectionField)
  @UI: {
    lineItem:       [{ position: 30, importance: #LOW }],
    identification: [{ position: 30 }]
  }
  Title;

  @UI: {
    lineItem:       [{ position: 40, importance: #LOW }],
    identification: [{ position: 40 }],
    selectionField: [{ position: 40 }]
  }
  Description;

  // Estado: value help vinculado a ZDD_STATUS_VH_AGG con validación (solo valores permitidos)
  @Consumption.valueHelpDefinition: [{
    entity.name:    'zdd_status_vh_agg',
    entity.element: 'StatusCode',
    useForValidation: true
  }]
  @UI: {
    lineItem:       [{ position: 50, importance: #LOW }],
    identification: [{ position: 50 }],
    selectionField: [{ position: 50 }]
  }
  Status;

  // Prioridad: value help vinculado a ZDD_PRIORITY_VH_AGG con validación
  @Consumption.valueHelpDefinition: [{
    entity.name:    'zdd_priority_vh_agg',
    entity.element: 'PriorityCode',
    useForValidation: true
  }]
  @UI: {
    lineItem:       [{ position: 60, importance: #LOW }],
    identification: [{ position: 60 }],
    selectionField: [{ position: 60 }]
  }
  Priority;

  @UI: {
    lineItem:       [{ position: 70, importance: #LOW }],
    identification: [{ position: 70 }],
    selectionField: [{ position: 70 }]
  }
  CreationDate;

  @UI: {
    lineItem:       [{ position: 80, importance: #LOW }],
    identification: [{ position: 80 }],
    selectionField: [{ position: 80 }]
  }
  ChangedDate;

  @UI: {
    lineItem:       [{ position: 85, importance: #LOW }],
    identification: [{ position: 85 }],
    selectionField: [{ position: 85 }]
  }
  ResponsibleUser;

  // Campos de auditoría: ocultos en columnas y filtros (@UI.hidden: true)
  @UI.hidden: true
  @UI: {
    lineItem:       [{ position: 90,  importance: #LOW }],
    identification: [{ position: 90  }],
    selectionField: [{ position: 90  }]
  }
  LocalCreatedBy;

  @UI.hidden: true
  @UI: {
    lineItem:       [{ position: 100, importance: #LOW }],
    identification: [{ position: 100 }],
    selectionField: [{ position: 100 }]
  }
  LocalCreatedAt;

  @UI.hidden: true
  @UI: {
    lineItem:       [{ position: 110, importance: #LOW }],
    identification: [{ position: 110 }],
    selectionField: [{ position: 110 }]
  }
  LocalLastChangedBy;

  @UI.hidden: true
  @UI: {
    lineItem:       [{ position: 120, importance: #LOW }],
    identification: [{ position: 120 }],
    selectionField: [{ position: 120 }]
  }
  LocalLastChangedAt;

  @UI.hidden: true
  @UI: {
    lineItem:       [{ position: 130, importance: #LOW }],
    identification: [{ position: 130 }],
    selectionField: [{ position: 130 }]
  }
  LastChangedAt;

  // Asociación al historial: oculta en la UI (se muestra como facet, no como campo suelto)
  @UI.hidden: true
  _History;
}